/node_modules/
# vendor/ is built per-machine EXCEPT aps-common's src/, which is committed:
# release tarballs carry it as tracked bytes (.nextcloudignore keeps it in).
# Composer's installed extras under vendor/aps (the package's own composer.json,
# tests/, stub/) stay ignored — src/ is the artifact aps-sync reproduces.
/vendor/*
!/vendor/aps/
/vendor/aps/*
!/vendor/aps/common/
/vendor/aps/common/*
!/vendor/aps/common/src/
/.phpunit.cache/
/composer.phar
/tools/
# build — js/ is built, not committed: the release workflow builds it before packing
# the tarball (pack-app refuses a committed bundle), and a clone needs `npm ci && npm
# run build` before the app works. The .LICENSE.txt file terser extracts lands in js/
# with the bundle — ignored here, regenerated by every build — and it carries the
# third-party licence notices that travel inside the distribution. Sourcemaps are not
# shipped either.
/js/
*.js.map
.phpunit.result.cache
graphify-out/
