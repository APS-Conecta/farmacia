#!/bin/sh
# Refuses a commit whose staged diff would introduce an obvious secret.
# Enable once per clone: git config core.hooksPath .githooks
if git diff --cached | grep -qiE '(api[_-]?key|secret|token|password)["'"'"']?\s*[:=]\s*["'"'"'][^"'"'"' ]{8,}'; then
	echo "Refused: the staged diff looks like it contains a secret." >&2
	exit 1
fi